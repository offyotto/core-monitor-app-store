    "activity.loadExplanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'n Vraggemiddelde naby 1.0 is min of meer gelyk aan een ten volle besige logiese kern."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አማካይ 1.0 የሚጠጋ ሸክም በግምት አንድ ሙሉ ስራ ከበዛበት አመክንዮአዊ ኮር ጋር እኩል ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسط ​​التحميل القريب من 1.0 يساوي تقريبًا نواة منطقية واحدة مشغولة بالكامل."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "১.০ৰ ওচৰৰ লোডৰ গড় মোটামুটিভাৱে এটা সম্পূৰ্ণ ব্যস্ত লজিকেল কোৰৰ সমান।"
          }
        },
        "ay" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mä promedio de carga jak’an 1.0 ukax mä núcleo lógico completamente ocupado ukar uñtasitawa."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.0-a yaxın bir yük ortalaması təxminən bir tam məşğul məntiqi nüvəyə bərabərdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сярэдняя нагрузка каля 1,0 прыкладна роўная аднаму цалкам занятаму лагічнаму ядру."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средно натоварване близо до 1,0 приблизително се равнява на едно напълно заето логическо ядро."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.0 के लगे लोड औसत मोटा-मोटी पूरा तरीका से व्यस्त तार्किक कोर के बराबर होला।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.0 এর কাছাকাছি একটি লোড গড় মোটামুটিভাবে একটি সম্পূর্ণ ব্যস্ত লজিক্যাল কোরের সমান।"
          }
        },
        "bs" : {
