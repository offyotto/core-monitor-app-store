    "dashboard.readOnly" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leesalleen-monitering. Geen helper nie. Geen waaierbeheer nie. Geen dop nie."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ተነባቢ-ብቻ ክትትል። ረዳት የለም። የደጋፊዎች ቁጥጥር የለም። ምንም ክትትል የለም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مراقبة القراءة فقط. لا مساعد. لا يوجد تحكم في المروحة. لا تتبع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেৱল পঢ়িব পৰা নিৰীক্ষণ। কোনো সহায়ক নাই। কোনো ফেন নিয়ন্ত্ৰণ নাই। কোনো ট্ৰেকিং নাই।"
          }
        },
        "ay" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uñakipt’añatakiki uñjaña. Janiwa yanapirixa utjkiti. Janiw control de ventilador ukax utjkiti. Janiw arknaqañax utjkiti."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız oxumaq üçün monitorinq. Köməkçi yoxdur. Fan nəzarəti yoxdur. İzləmə yoxdur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маніторынг толькі для чытання. Няма памочніка. Няма кіравання вентылятарам. Няма адсочвання."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мониторинг само за четене. Без помощник. Без управление на вентилатора. Без проследяване."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली पढ़े खातिर निगरानी कइल जा रहल बा. ना कवनो मददगार। कवनो पंखा नियंत्रण ना. कवनो ट्रैकिंग ना होखे."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র পঠন পর্যবেক্ষণ. সাহায্যকারী নেই। ফ্যানের নিয়ন্ত্রণ নেই। কোন ট্র্যাকিং."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadgledanje samo za čitanje. Nema pomoćnika. Nema kontrole ventilatora. Nema praćenja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supervisió de només lectura. Cap ajudant. Sense control del ventilador. Sense seguiment."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only nga pagmonitor. Walay katabang. Walay kontrol sa fan. Walay pagsubay."
          }
        },
        "co" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveglianza di sola lettura. Nisun aiutu. Nisun cuntrollu di fan. Nisun seguimentu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitorování pouze pro čtení. Žádný pomocník. Žádné ovládání ventilátoru. Žádné sledování."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitro darllen yn unig. Dim helpwr. Dim rheolaeth gefnogwr. Dim olrhain."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivebeskyttet overvågning. Ingen hjælper. Ingen ventilatorstyring. Ingen sporing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur-Lese-Überwachung. Kein Helfer. Keine Lüftersteuerung. Keine Nachverfolgung."
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ހަމައެކަނި ކިޔުމަށް މޮނިޓަރިންގ. އެހީތެރިއެއް ނެތެވެ. ފަންކާ ކޮންޓްރޯލެއް ނެތެވެ. ޓްރެކިންއެއް ނެތެވެ."
          }
        },
        "ee" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuxexlẽ ɖeɖeko ƒe ŋkuléle ɖe nu ŋu. Kpeɖeŋutɔ aɖeke meli o. Fan dzi ɖuɖu aɖeke meli o. Womekplɔ ame aɖeke ɖo o."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολούθηση μόνο για ανάγνωση. Κανένας βοηθός. Χωρίς έλεγχο ανεμιστήρα. Χωρίς παρακολούθηση."
