        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS nem tesz közzé pontos CPU hőmérsékleti értéket harmadik féltől származó alkalmazások számára, ezért ez a kártya az Apple által közzétett rendszerhőjeleket használja."
