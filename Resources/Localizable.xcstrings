        }
      }
    },
    "dashboard.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, termiese, geheue, berging, netwerk, weer en krag in een aansig."
