        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការត្រួតពិនិត្យបានតែអាន។ គ្មានអ្នកជួយទេ។ គ្មានការគ្រប់គ្រងកង្ហារទេ។ គ្មានការតាមដានទេ។"
