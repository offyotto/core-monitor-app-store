        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU፣ ቴርማል፣ ማህደረ ትውስታ፣ ማከማቻ፣ አውታረ መረብ፣ የአየር ሁኔታ እና ሃይል በአንድ እይታ።"
