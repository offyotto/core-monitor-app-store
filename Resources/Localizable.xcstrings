        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моніторинг лише для читання. Жодного помічника. Немає керування вентилятором. Немає відстеження."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف پڑھنے کی نگرانی۔ کوئی مددگار نہیں۔ کوئی پنکھا کنٹرول نہیں ہے۔ کوئی ٹریکنگ نہیں۔"
