        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ನಿಂದ ವರದಿ ಮಾಡಲಾದ ಮಾದರಿ ಗುರುತಿಸುವಿಕೆಯ ಕ್ಯಾಟಲಾಗ್ ಮತ್ತು ಚಿಪ್ ಹೆಸರಿನಿಂದ ಪರಿಹರಿಸಲಾಗಿದೆ."
