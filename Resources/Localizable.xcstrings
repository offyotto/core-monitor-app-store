        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU، الحرارة، الذاكرة، التخزين، الشبكة، الطقس، والطاقة في عرض واحد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, তাপীয়, মেমৰি, সংৰক্ষণ, নেটৱৰ্ক, বতৰ, আৰু শক্তি এটা দৃশ্যত।"
          }
        },
        "ay" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, térmico, memoria, almacenamiento, red, pacha, ukhamaraki ch’ama mä uñakipaña."
          }
        },
        "az" : {
