        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pa pibliye yon lekti egzak tanperati CPU nan aplikasyon twazyèm pati, kidonk kat sa a sèvi ak siyal tèmik sistèm Apple ekspoze."
