        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לייענען-בלויז מאָניטאָרינג. קיין העלפער. קיין פאָכער קאָנטראָל. קיין טראַקינג."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abojuto Ka-nikan. Ko si oluranlọwọ. Ko si iṣakoso afẹfẹ. Ko si ipasẹ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读监控。没有帮手。无风扇控制。没有跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只讀監控。沒有幫手。無風扇控制。沒有跟踪。"
