        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang macOS wala magmantala ug eksaktong CPU nga temperatura nga pagbasa sa mga third-party nga apps, mao nga kini nga kard naggamit sa sistema sa thermal signal nga gibutyag sa Apple."
