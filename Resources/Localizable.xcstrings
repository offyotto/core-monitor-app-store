    "weather.enable.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor vereis jou ligging om die weer te vertoon."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor የአየር ሁኔታን ለማሳየት አካባቢዎን ይፈልጋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب core-monitor موقعك لعرض الطقس."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বতৰ প্ৰদৰ্শন কৰিবলৈ core-monitor ৰ বাবে আপোনাৰ অৱস্থানৰ প্ৰয়োজন।"
          }
        },
        "ay" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor ukax kawkhantix utjki ukax pacha uñacht’ayañatakiw mayi."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor havanı göstərmək üçün yerinizi tələb edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor патрабуе вашага месцазнаходжання для адлюстравання надвор'я."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor изисква вашето местоположение, за да покаже времето."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor के मौसम के प्रदर्शित करे खातिर राउर स्थान के जरूरत होला।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor আবহাওয়া প্রদর্শনের জন্য আপনার অবস্থানের প্রয়োজন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor zahtijeva vašu lokaciju za prikaz vremena."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor requereix la vostra ubicació per mostrar el temps."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gikinahanglan sa core-monitor ang imong lokasyon aron ipakita ang panahon."
          }
        },
        "co" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor richiede u vostru locu per vede u clima."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor vyžaduje k zobrazení počasí vaši polohu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae core-monitor yn gofyn am eich lleoliad i arddangos y tywydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor kræver din placering for at vise vejret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor benötigt Ihren Standort, um das Wetter anzuzeigen."
          }
        },
        "dv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "core-monitor އިން މޫސުން ދައްކާލުމަށް ތިބާގެ ލޮކޭޝަން ބޭނުންވެއެވެ."
          }
        },
        "ee" : {
