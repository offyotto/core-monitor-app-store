        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS तृतीय-पक्ष ऐप्स पर सटीक CPU तापमान रीडिंग प्रकाशित नहीं करता है, इसलिए यह कार्ड Apple द्वारा प्रदर्शित सिस्टम थर्मल सिग्नल का उपयोग करता है।"
