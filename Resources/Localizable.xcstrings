        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വായന-മാത്രം നിരീക്ഷണം. സഹായി ഇല്ല. ഫാൻ നിയന്ത്രണമില്ല. ട്രാക്കിംഗ് ഇല്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зөвхөн унших боломжтой хяналт. Туслагч байхгүй. Сэнсний хяналт байхгүй. Хяналт байхгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवळ-वाचनीय निरीक्षण. मदतनीस नाही. पंख्यावर नियंत्रण नाही. ट्रॅकिंग नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemantauan baca sahaja. Tiada pembantu. Tiada kawalan kipas. Tiada pengesanan."
