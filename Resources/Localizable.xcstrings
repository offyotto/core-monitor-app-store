        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, termisk, minne, lagring, nätverk, väder och kraft i en vy."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, halijoto, kumbukumbu, hifadhi, mtandao, hali ya hewa na nishati katika mwonekano mmoja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, தெர்மல், மெமரி, ஸ்டோரேஜ், நெட்வொர்க், வானிலை மற்றும் ஒரு பார்வையில் சக்தி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, థర్మల్, మెమరీ, స్టోరేజ్, నెట్‌వర్క్, వాతావరణం మరియు పవర్ ఒకే వీక్షణలో."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, гармӣ, хотира, нигаҳдорӣ, шабака, обу ҳаво ва қудрат дар як намоиш."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU ความร้อน หน่วยความจำ อุปกรณ์จัดเก็บข้อมูล เครือข่าย สภาพอากาศ และพลังงานในมุมมองเดียว"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, ýylylyk, ýat, ýatda saklamak, tor, howa we güýç bir görnüşde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, termal, bellek, depolama, ağ, hava durumu ve güç tek bir görünümde."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, җылылык, хәтер, саклау, челтәр, һава торышы һәм көч бер күренештә."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU ، ئىسسىقلىق ، ئىچكى ساقلىغۇچ ، ساقلاش ، تور ، ھاۋارايى ۋە قۇۋۋەت."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, охолодження, пам’ять, сховище, мережа, погода та живлення в одному поданні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU، تھرمل، میموری، اسٹوریج، نیٹ ورک، موسم، اور پاور ایک ہی منظر میں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, termal, xotira, saqlash, tarmoq, ob-havo va quvvat bir ko'rinishda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, nhiệt, bộ nhớ, lưu trữ, mạng, thời tiết và năng lượng trong một chế độ xem."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-CPU, i-thermal, inkumbulo, ugcino, inethiwekhi, imozulu, kunye namandla kwimbono enye."
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, טערמאַל, זכּרון, סטאָרידזש, נעץ, וועטער און מאַכט אין איין מיינונג."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, gbona, iranti, ibi ipamọ, nẹtiwọki, oju ojo, ati agbara ni wiwo kan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU，热量、内存、存储、网络、天气和电量一目了然。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU，熱、記憶、儲存、網路、天氣和電量一目了然。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-CPU, i-thermal, inkumbulo, isitoreji, inethiwekhi, isimo sezulu, namandla ekubukeni okukodwa."
          }
        }
      }
