        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කියවීමට පමණක් නිරීක්ෂණය කිරීම. සහායකයෙක් නැත. විදුලි පංකා පාලනයක් නැත. ලුහුබැඳීමක් නැත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitorovanie iba na čítanie. Žiadny pomocník. Žiadne ovládanie ventilátora. Žiadne sledovanie."
