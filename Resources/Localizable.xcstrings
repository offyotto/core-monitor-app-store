        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanaraha-maso mamaky fotsiny. Tsy misy mpanampy. Tsy misy fanaraha-maso ny mpankafy. Tsy misy fanaraha-maso."
