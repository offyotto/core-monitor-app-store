        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nezveřejňuje přesné údaje o teplotě CPU aplikacím třetích stran, takže tato karta používá systémové tepelné signály, které Apple vystavuje."
