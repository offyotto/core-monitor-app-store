        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kamungkinan ngurangan kinerja pikeun niiskeun sistem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kommer sannolikt att minska prestandan för att kyla systemet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS huenda ikapunguza utendakazi ili kupoza mfumo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணினியை குளிர்விக்க macOS செயல்திறனைக் குறைக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS సిస్టమ్‌ను చల్లబరచడానికి పనితీరును తగ్గించే అవకాశం ఉంది."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS эҳтимолан корношоямиро барои сард кардани система коҳиш медиҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS มีแนวโน้มที่จะลดประสิทธิภาพลงเพื่อทำให้ระบบเย็นลง"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ulgamy sowatmak üçin öndürijiligi azaldar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS muhtemelen sistemi soğutmak için performansı düşürüyor."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, мөгаен, системаны суыту өчен эшне киметә."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS بەلكىم سىستېمىنى سوۋۇتۇش ئىقتىدارىنى تۆۋەنلىتىشى مۇمكىن."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ймовірно, macOS знижує продуктивність, щоб охолодити систему."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS سسٹم کو ٹھنڈا کرنے کے لیے ممکنہ طور پر کارکردگی کو کم کر رہا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tizimni sovutish uchun unumdorlikni pasaytiradi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS có thể sẽ giảm hiệu suất để làm mát hệ thống."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-macOS inokuba yehlisa ukusebenza ukupholisa inkqubo."
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS איז מסתּמא רידוסינג פאָרשטעלונג צו קילן די סיסטעם."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ṣee ṣe idinku iṣẹ ṣiṣe lati tutu eto naa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 可能会降低性能以冷却系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
