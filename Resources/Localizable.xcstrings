        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಓದಲು-ಮಾತ್ರ ಮೇಲ್ವಿಚಾರಣೆ. ಸಹಾಯಕ ಇಲ್ಲ. ಫ್ಯಾನ್ ನಿಯಂತ್ರಣವಿಲ್ಲ. ಟ್ರ್ಯಾಕಿಂಗ್ ಇಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 전용 모니터링. 도우미가 없습니다. 팬 제어가 없습니다. 추적이 없습니다."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xwendin-tenê çavdêrîkirina. Alîkar tune. No kontrol fan. No şopandin."
