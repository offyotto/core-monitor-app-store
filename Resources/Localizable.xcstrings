    "thermal.publicAPI.note" : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS publiseer nie 'n presiese CPU-temperatuurlesing aan derdeparty-toepassings nie, so hierdie kaart gebruik die stelsel se termiese seine wat Apple blootstel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ትክክለኛውን የ CPU የሙቀት ንባብ ለሶስተኛ ወገን መተግበሪያዎች አያትምም፣ ስለዚህ ይህ ካርድ አፕል የሚያጋልጠውን የስርዓት የሙቀት ምልክቶችን ይጠቀማል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنشر macOS قراءة دقيقة لدرجة حرارة CPU لتطبيقات الطرف الثالث، لذلك تستخدم هذه البطاقة الإشارات الحرارية للنظام التي تكشفها Apple."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS এ তৃতীয় পক্ষৰ এপসমূহলৈ সঠিক CPU উষ্ণতা পঢ়া প্ৰকাশ নকৰে, গতিকে এই কাৰ্ডে এপলে উন্মোচন কৰা চিষ্টেম থাৰ্মেল সংকেতসমূহ ব্যৱহাৰ কৰে।"
          }
        },
        "ay" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ukax janiw mä chiqap CPU temperatura uñakipañ kimsïr apps ukar uñt’aykiti, ukhamax aka tarjeta ukax sistema señales térmicas Apple ukan uñacht’ayat apnaqi."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS üçüncü tərəf proqramları üçün dəqiq CPU temperatur göstəricisini dərc etmir, ona görə də bu kart Apple-ın ifşa etdiyi sistem istilik siqnallarından istifadə edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не публікуе дакладныя паказанні тэмпературы CPU у праграмах іншых вытворцаў, таму гэтая карта выкарыстоўвае сістэмныя цеплавыя сігналы, якія выстаўляе Apple."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не публикува точно отчитане на температурата на CPU в приложения на трети страни, така че тази карта използва системните топлинни сигнали, които Apple излага."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS थर्ड पार्टी ऐप के सटीक CPU तापमान रीडिंग प्रकाशित ना करेला, एहसे ए कार्ड में एप्पल के उजागर करेवाला सिस्टम थर्मल सिग्नल के इस्तेमाल कईल जाला।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS তৃতীয় পক্ষের অ্যাপগুলিতে সঠিক CPU তাপমাত্রা রিডিং প্রকাশ করে না, তাই এই কার্ডটি অ্যাপল প্রকাশ করে এমন সিস্টেম তাপীয় সংকেত ব্যবহার করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne objavljuje tačno očitavanje temperature CPU aplikacijama trećih strana, tako da ova kartica koristi sistemske termalne signale koje Apple izlaže."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
