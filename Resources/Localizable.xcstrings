        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पढ्ने मात्र निगरानी। सहयोगी छैन। प्रशंसक नियन्त्रण छैन। कुनै ट्र्याकिङ छैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen-lezen-bewaking. Geen helper. Geen ventilatorregeling. Geen tracking."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hordoffii dubbisa qofa. Gargaaraa hin qabu. To'annoo fanjii hin qabu. Hordoffii hin qabu."
