        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მხოლოდ წაკითხვის მონიტორინგი. არავითარი დამხმარე. არ არის ვენტილატორის კონტროლი. თვალთვალი არ არის."
