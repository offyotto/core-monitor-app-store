        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS birtir ekki nákvæman CPU hitastig í forritum frá þriðja aðila, þannig að þetta kort notar hitamerki kerfisins sem Apple afhjúpar."
