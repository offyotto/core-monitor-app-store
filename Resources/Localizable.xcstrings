        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဖတ်ရှုခြင်းသာ စောင့်ကြည့်ခြင်း။ ကူညီသူမရှိ။ ပရိတ်သတ် ထိန်းချုပ်မှု မရှိပါ။ ခြေရာခံခြင်း မရှိပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivebeskyttet overvåking. Ingen hjelper. Ingen viftekontroll. Ingen sporing."
